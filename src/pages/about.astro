---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About · Joblo Projects">
  <h1>About Me</h1>

  <div class="card" style="margin-top: 1.5rem;">
    <p>
      Hi, I'm <strong>Joblo</strong>. I build and deploy projects on AWS —
      learning the full stack from frontend to infrastructure.
    </p>
    <p>
      This site is my project hub. Everything you see here is served from a
      Docker container behind Nginx with SSL, running on an AWS VPS.
    </p>
    <p>
      Currently learning: <strong>Astro</strong>, <strong>Docker</strong>,
      <strong>Nginx</strong>, and <strong>AWS</strong>.
    </p>
  </div>
</BaseLayout>
